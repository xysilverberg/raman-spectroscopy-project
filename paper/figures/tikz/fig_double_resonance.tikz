\begin{tikzpicture}[scale=0.9, >=stealth, font=\small]
    % Dirac Cones at K and K'
    \node[font=\bfseries] at (2.5, 4.5) {Lembah $K$};
    \node[font=\bfseries] at (7.5, 4.5) {Lembah $K'$};
    
    % Left Dirac Cone (K)
    \draw[thick, fill=blue!10, opacity=0.7] (2.5, 2.0) -- (1.0, 4.0) -- (4.0, 4.0) -- cycle;
    \draw[thick, fill=blue!15, opacity=0.7] (2.5, 2.0) -- (1.0, 0.0) -- (4.0, 0.0) -- cycle;
    
    % Right Dirac Cone (K')
    \draw[thick, fill=orange!10, opacity=0.7] (7.5, 2.0) -- (6.0, 4.0) -- (9.0, 4.0) -- cycle;
    \draw[thick, fill=orange!15, opacity=0.7] (7.5, 2.0) -- (6.0, 0.0) -- (9.0, 0.0) -- cycle;
    
    % Step 1: Vertical Optical Absorption (e-h pair creation)
    \draw[->, very thick, blue!80!black] (2.0, 0.6) -- (2.0, 3.4) node[midway, left] {(1) $\hbar\omega_0$};
    \filldraw[blue!80!black] (2.0, 3.4) circle (2pt) node[above left] {$e^-$};
    \filldraw[white, draw=blue!80!black, thick] (2.0, 0.6) circle (2pt) node[below left] {$h^+$};
    
    % Step 2: Inelastic Phonon Scattering from K to K' (wavevector q)
    \draw[->, very thick, red!80!black, decorate, decoration={snake, amplitude=1.2mm, segment length=3mm}] 
        (2.0, 3.4) -- (7.0, 3.2) node[midway, above] {(2) Fonon iTO ($+\mathbf{q}$)};
    \filldraw[red!80!black] (7.0, 3.2) circle (2pt);
    
    % Step 3: Second Inelastic Scattering or Defect Backscattering from K' to K
    \draw[->, very thick, green!60!black, decorate, decoration={snake, amplitude=1.2mm, segment length=3mm}] 
        (7.0, 3.2) -- (2.2, 3.0) node[midway, below] {(3) Fonon ($-\mathbf{q}$) [2D] / Defek [D]};
    \filldraw[green!60!black] (2.2, 3.0) circle (2pt);
    
    % Step 4: Radiative e-h Recombination (Emission of Raman Photon)
    \draw[->, very thick, dashed, purple!80!black] (2.2, 3.0) -- (2.0, 0.6) node[midway, right] {(4) $\hbar\omega_s$};
    
    % Bottom Legend
    \node[draw, rounded corners, fill=gray!5, align=left, font=\footnotesize] at (5.0, -1.2) {
        \textbf{Mekanisme Resonansi Ganda (Double Resonance) Grafena:}\\
        $\bullet$ \textbf{Pita 2D:} Hamburan elastik/inelastik oleh \textbf{dua fonon} ($+\mathbf{q}$ dan $-\mathbf{q}$), simetri momentum $\sum \mathbf{q} = 0$ (tanpa defek).\\
        $\bullet$ \textbf{Pita D:} Hamburan oleh \textbf{satu fonon} ($+\mathbf{q}$) dan pembalikan momentum oleh \textbf{defek kisi} (memerlukan defek).
    };
\end{tikzpicture}
