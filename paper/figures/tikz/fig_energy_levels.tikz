\begin{tikzpicture}[scale=0.95, >=stealth, font=\small]
    % Ground Electronic State S0
    \draw[very thick, black] (0, 0) -- (12, 0) node[right] {$v=0$};
    \draw[thick, black!70] (0, 0.8) -- (12, 0.8) node[right] {$v=1$};
    \node[left, font=\bfseries] at (0, 0.4) {S$_0$ (Keadaan Elektronik Dasar)};
    
    % Virtual States (Dashed)
    \draw[dashed, thick, gray] (0.5, 3.8) -- (8.5, 3.8) node[right] {Keadaan Virtual $|v_{\text{virt}}\rangle$};
    
    % Real Excited Electronic State S1
    \draw[very thick, red!80!black] (9.2, 4.8) -- (12.5, 4.8) node[right] {$v'=0$};
    \draw[thick, red!60!black] (9.2, 5.5) -- (12.5, 5.5) node[right] {$v'=1$};
    \node[above, red!80!black, font=\bfseries] at (10.85, 5.6) {S$_1$ (Keadaan Tereksitasi Nyata)};
    
    % 1. Rayleigh Scattering
    \draw[->, thick, blue!80!black] (1.5, 0) -- (1.5, 3.8) node[midway, left] {$\hbar\omega_0$};
    \draw[->, thick, dashed, blue!80!black] (1.8, 3.8) -- (1.8, 0) node[midway, right] {$\hbar\omega_0$};
    \node[below, align=center] at (1.65, -0.3) {\textbf{Hamburan Rayleigh}\\$\Delta v = 0$, $\omega_s = \omega_0$};
    
    % 2. Stokes Raman
    \draw[->, thick, blue!80!black] (4.2, 0) -- (4.2, 3.8) node[midway, left] {$\hbar\omega_0$};
    \draw[->, thick, dashed, orange!80!black] (4.5, 3.8) -- (4.5, 0.8) node[midway, right] {$\hbar\omega_S$};
    \node[below, align=center] at (4.35, -0.3) {\textbf{Hamburan Stokes}\\$\Delta v = +1$, $\omega_S = \omega_0 - \omega_v$};
    
    % 3. Anti-Stokes Raman
    \draw[->, thick, blue!80!black] (7.2, 0.8) -- (7.2, 3.8) node[midway, left] {$\hbar\omega_0$};
    \draw[->, thick, dashed, purple!80!black] (7.5, 3.8) -- (7.5, 0) node[midway, right] {$\hbar\omega_{AS}$};
    \node[below, align=center] at (7.35, -0.3) {\textbf{Hamburan Anti-Stokes}\\$\Delta v = -1$, $\omega_{AS} = \omega_0 + \omega_v$};
    
    % 4. Resonance Raman
    \draw[->, very thick, red!80!black] (10.5, 0) -- (10.5, 4.8) node[midway, left] {$\hbar\omega_0 \approx E_e - E_g$};
    \draw[->, very thick, dashed, green!60!black] (11.0, 4.8) -- (11.0, 0.8) node[midway, right] {$\hbar\omega_S$};
    \node[below, align=center] at (10.75, -0.3) {\textbf{Resonance Raman}\\Eksitasi Nyata S$_1$ ($10^3 - 10^6\times$)};
\end{tikzpicture}
